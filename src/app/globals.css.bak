@import "tailwindcss";

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    overflow-x: hidden;
    overflow-y: auto;
}

:root {
    --bg-primary: #050505;
    --bg-secondary: #0e0e0e;
    --text-primary: #ffffff;
    --text-secondary: #c8c8d0;
    --text-gray: #8d8d95;
    --border-color: #3c3c44;
    --border-dotted: #4a4a4f;
    --line-color: #3c3c44;
    --accent: #22c55e;
    --font-heading: var(--font-outfit), Inter, sans-serif;
    --font-dancing: var(--font-dancing), cursive;
}

[data-theme="light"] {
    --bg-primary: #fafafa;
    --bg-secondary: #ffffff;
    --text-primary: #000000;
    --text-secondary: #3f3f46;
    --text-gray: #71717a;
    --border-color: #b8bfc8;
    --border-dotted: #9aaab8;
    --line-color: #b8bfc8;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica', Arial, sans-serif;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    font-size: 1rem;
    overflow-x: hidden;
    overflow-y: auto;
}

html.theme-color-transition *,
html.theme-color-transition *::before,
html.theme-color-transition *::after {
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, fill 0.25s ease, stroke 0.25s ease;
}

@supports (view-transition-name: root) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
        animation-duration: 0.35s;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    html.theme-reveal-active::view-transition-old(root) {
        animation-name: theme-fade-soft;
    }

    html.theme-reveal-active::view-transition-new(root) {
        animation-name: theme-reveal-down;
    }
}

@keyframes theme-reveal-down {
    from {
        clip-path: inset(0 0 100% 0);
        filter: blur(2px);
    }
    to {
        clip-path: inset(0 0 0 0);
        filter: blur(0);
    }
}

@keyframes theme-fade-soft {
    from {
        opacity: 1;
    }
    to {
        opacity: 0.6;
    }
}

.main-wrapper {
    min-height: 100vh;
    max-width: clamp(360px, 85.5vw, 864px);
    margin: 0 auto;
    position: relative;
    background-color: var(--bg-primary);
    padding: 0 1.5rem 3rem;
}

.main-wrapper::before,
.main-wrapper::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: repeating-linear-gradient(
        to bottom,
        var(--border-dotted) 0px,
        var(--border-dotted) 6px,
        transparent 6px,
        transparent 14px
    );
    pointer-events: none;
    z-index: 300;
}

.main-wrapper::before {
    left: 0;
}

.main-wrapper::after {
    right: 0;
}

.container {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 1;
}

/* THEME TOGGLE */
.theme-toggle {
    width: 32px;
    height: 32px;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    color: var(--text-secondary);
    flex-shrink: 0;
}

.theme-toggle:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
    background-color: var(--bg-secondary);
}

/* HEADER */
.header {
    padding: 2rem 0 1.75rem;
    position: relative;
    z-index: 50;
}
.header::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.header-main {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
}

.profile-img-container {
    position: relative;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--border-color);
}

.header-info {
    flex: 1;
    min-width: 0;
}

.profile-image {
    transition: opacity 0.32s ease, transform 0.32s ease;
}

.profile-image-default {
    opacity: 1;
    transform: scale(1);
}

.profile-image-hover {
    opacity: 0;
    transform: scale(1.03);
}

.profile-image-swap:hover .profile-image-default {
    opacity: 0;
    transform: scale(1.03);
}

.profile-image-swap:hover .profile-image-hover {
    opacity: 1;
    transform: scale(1);
}

.header-info h1 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
}

.header-subtitle {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: 0.2rem;
}

.header-location {
    font-size: 0.8rem;
    color: var(--text-gray);
    margin-top: 0.15rem;
}

.subtitle {
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    font-weight: 500;
    color: var(--text-secondary);
    margin: 0.5rem 0;
}

/* SOCIAL CARDS GRID */
.social-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.625rem;
    margin-top: 1.5rem;
}

.social-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
    background-color: var(--bg-secondary);
    transition: border-color 0.2s ease, background-color 0.2s ease;
}

.social-card:hover {
    border-color: var(--text-secondary);
    background-color: var(--bg-primary);
}

.social-card-icon {
    color: var(--text-secondary);
    flex-shrink: 0;
    display: flex;
    align-items: center;
}

.social-card-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
}

.social-card-platform {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
}

.social-card-handle {
    font-size: 0.75rem;
    color: var(--text-gray);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.social-card-arrow {
    color: var(--text-gray);
    font-size: 0.875rem;
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
}

.social-card:hover .social-card-arrow {
    transform: translateX(2px);
    color: var(--text-secondary);
}

/* SITE NAV */
.site-nav {
    position: sticky;
    top: 0;
    z-index: 200;
    background-color: var(--bg-primary);
    margin: 0 -1.5rem;
    padding: 0 1.5rem;
}

.site-nav::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.site-nav-inner {
    display: flex;
    align-items: center;
    height: 44px;
    gap: 1rem;
}

.site-nav-left {
    flex: 1;
}

.site-nav-center {
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.site-nav-link {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.35rem 0.65rem;
    border-radius: 5px;
    transition: color 0.15s ease, background-color 0.15s ease;
}

.site-nav-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-secondary);
}

.site-nav-link.active {
    color: var(--text-primary);
    font-weight: 600;
}

.site-nav-right {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
}

.site-nav-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.65rem;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s ease;
}

.site-nav-search:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
    background-color: var(--bg-secondary);
}

.site-nav-search-kbd {
    font-size: 0.7rem;
    color: var(--text-gray);
    letter-spacing: 0.02em;
}

.site-nav-gh-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
}

.site-nav-gh-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-primary);
    border-color: var(--text-secondary);
}

.site-nav-gh-count {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
}

.site-nav-views-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    border-radius: 5px;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.75rem;
    cursor: default;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    text-decoration: none;
}

.site-nav-views-btn.active {
    color: var(--text-primary);
    border-color: var(--text-secondary);
    background: var(--bg-secondary);
    cursor: pointer;
}

.site-nav-views-count {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
}

.site-nav-sep {
    width: 1px;
    height: 16px;
    background: var(--border-color);
    flex-shrink: 0;
}

.site-nav-mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    border-radius: 5px;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.72rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}

.site-nav-mode-btn:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
}

.site-nav-mode-btn.active {
    background: var(--text-primary);
    color: var(--bg-primary);
    border-color: var(--text-primary);
}

.site-nav-mode-label {
    font-family: 'Courier New', monospace;
    letter-spacing: 0.02em;
}

/* ================================
   AGENT VIEW
   ================================ */

.agent-view {
    position: relative;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    line-height: 1.6;
}
.agent-view::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.agent-view-header {
    padding: 1.25rem 1.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
}
.agent-view-header::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.agent-view-header-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.agent-view-method {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
}

.agent-view-path {
    font-size: 0.8rem;
    color: var(--text-primary);
}

.agent-view-status {
    font-size: 0.72rem;
    color: #22c55e;
    margin-left: auto;
}

.agent-view-meta {
    font-size: 0.72rem;
    color: var(--text-gray);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
}

.agent-view-comment {
    color: var(--text-gray);
    font-style: italic;
}

.agent-view-exit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.55rem;
    border-radius: 5px;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.72rem;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
    font-style: normal;
}

.agent-view-exit-btn:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
}

.agent-view-pre {
    margin: 0;
    padding: 1.25rem 0;
    overflow-x: auto;
    background: transparent;
    color: var(--text-primary);
}

.agent-view-pre code {
    display: block;
}

.agent-view-line {
    display: flex;
    gap: 0;
    min-height: 1.6em;
    padding: 0 1rem;
}

.agent-view-line:hover {
    background: rgba(128, 128, 128, 0.06);
}

.agent-view-ln {
    display: inline-block;
    min-width: 2.75rem;
    text-align: right;
    padding-right: 1.25rem;
    color: var(--text-gray);
    opacity: 0.45;
    user-select: none;
    flex-shrink: 0;
}

/* JSON syntax token colors */
.jv-key  { color: #9cdcfe; }
.jv-str  { color: #ce9178; }
.jv-num  { color: #b5cea8; }
.jv-bool { color: #569cd6; }
.jv-null { color: #569cd6; }

[data-theme="light"] .jv-key  { color: #0550ae; }
[data-theme="light"] .jv-str  { color: #b5490a; }
[data-theme="light"] .jv-num  { color: #116329; }
[data-theme="light"] .jv-bool { color: #0032a0; }
[data-theme="light"] .jv-null { color: #0032a0; }

/* ================================
   HERO SECTION
   ================================ */

/* Banner */
.hero-banner {
    margin: 0 -1.5rem;
    padding: 4.72rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 310px;
}

/* dot grid */
.hero-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.18) 1.2px, transparent 1.2px);
    background-size: 10px 10px;
    pointer-events: none;
    z-index: 0;
}

/* full-width dashed top + bottom lines */
.hero-banner::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
    z-index: 0;
}

[data-theme="light"] .hero-banner::before {
    background-image: radial-gradient(circle, rgba(0,0,0,0.13) 1.2px, transparent 1.2px);
}

.hero-banner-name {
    font-family: var(--font-dancing);
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 400;
    color: var(--text-primary);
    text-align: center;
    position: relative;
    z-index: 1;
    letter-spacing: 0.01em;
}

/* Profile row */
.hero-profile-row {
    display: flex;
    align-items: flex-start;
    margin: 0 -1.5rem;
    position: relative;
}
.hero-profile-row::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.hero-avatar-col {
    width: 210px;
    flex-shrink: 0;
    padding: 1rem 1.25rem 1.25rem 1.5rem;
    width: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
}

.hero-avatar-outer {
    position: relative;
    display: inline-block;
}

.hero-avatar-circle {
    position: relative;
    width: 160px;
    height: 160px;
    border-radius: 14px;
    overflow: hidden;
    border: 2px solid var(--border-color);
    background: var(--bg-secondary);
}

.hero-flag-badge {
    position: absolute;
    top: 4px;
    left: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
}

.hero-flag-emoji {
    font-size: 2rem;
    line-height: 1;
}

.hero-identity-toggle {
    position: absolute;
    bottom: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    z-index: 10;
    transition: all 0.2s ease;
    padding: 0;
}

.hero-identity-toggle:hover {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border-color: var(--text-secondary);
}

.hero-identity-toggle:hover svg {
    animation: swap-spin 0.45s ease-in-out;
}

.hero-identity-toggle.active {
    background: #1d9bf0;
    border-color: #1d9bf0;
    color: #fff;
}

@keyframes swap-spin {
    0%   { transform: rotate(0deg); }
    100% { transform: rotate(180deg); }
}

.hero-verified-twitter {
    color: #1d9bf0;
}

/* Name block */
.hero-name-block {
    flex: 1;
    padding: 0.85rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 90px;
}

.hero-code-hint {
    font-family: 'Courier New', monospace;
    font-size: 0.7rem;
    color: var(--text-gray);
    opacity: 0.45;
    margin-bottom: 0.35rem;
    letter-spacing: 0.01em;
}

.hero-name-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.3rem;
}

.hero-name {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text-primary);
}

.hero-verified {
    width: 20px;
    height: 20px;
    color: #1d9bf0;
    flex-shrink: 0;
}

.hero-subtitle {
    font-size: 0.8rem;
    color: var(--text-secondary);
}

/* Hero widgets column (right side of profile row) */
.hero-widgets-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.85rem 1rem 1rem 0.85rem;
    width: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    flex-shrink: 0;
    align-items: flex-start;
}

.hero-widget-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    border-radius: 5px;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.75rem;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
}

.hero-widget-btn:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
}

.hero-widget-btn.active {
    color: var(--text-primary);
    border-color: var(--text-secondary);
    background: var(--bg-secondary);
}

/* Role flip animation */
.hero-role-text {
    display: inline-block;
    transform-style: preserve-3d;
    will-change: transform, opacity;
}

@keyframes role-flip-in {
    0% {
        opacity: 0;
        transform: perspective(400px) rotateX(-55deg) translateY(6px);
    }
    100% {
        opacity: 1;
        transform: perspective(400px) rotateX(0deg) translateY(0);
    }
}

@keyframes role-flip-out {
    0% {
        opacity: 1;
        transform: perspective(400px) rotateX(0deg) translateY(0);
    }
    100% {
        opacity: 0;
        transform: perspective(400px) rotateX(55deg) translateY(-6px);
    }
}

.hero-role-in {
    animation: role-flip-in 0.36s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.hero-role-out {
    animation: role-flip-out 0.34s cubic-bezier(0.55, 0, 1, 0.45) forwards;
}

/* Info box */
.hero-info-box {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin: 1.1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0;
}

.hero-info-divider {
    height: 1px;
    background: var(--border-color);
    margin: 0.5rem 0;
}

.hero-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
}

.info-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.25rem;
}

.info-icon-box {
    width: 26px;
    height: 26px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    flex-shrink: 0;
}

.info-text {
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.info-time {
    color: var(--text-primary);
    font-weight: 600;
}

.info-link {
    color: var(--text-secondary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
}

.info-link:hover {
    color: var(--text-primary);
    border-bottom-color: var(--border-color);
}

/* Social cards grid */
.hero-social-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--border-color);
    border-radius: 0;
}

.hero-social-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    border: 0.5px solid var(--border-color);
    text-decoration: none;
    color: var(--text-primary);
    transition: background-color 0.15s ease;
}

.hero-social-card:hover {
    background-color: var(--bg-secondary);
}

.hero-social-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.hero-social-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
}

.hero-social-platform {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hero-social-handle {
    font-size: 0.75rem;
    color: var(--text-gray);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hero-social-arrow {
    color: var(--text-gray);
    flex-shrink: 0;
    transition: transform 0.15s ease, color 0.15s ease;
}

.hero-social-card:hover .hero-social-arrow {
    transform: translate(2px, -2px);
    color: var(--text-secondary);
}

/* TECH ICON GRID (legacy) */
.tech-icon-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.5rem;
}

.tech-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: var(--text-gray);
}

.tech-icon-item img {
    width: 32px;
    height: 32px;
    object-fit: contain;
}

/* TECH PILL GRID */
.tech-stack-section {
    padding: 0 0 2.5rem;
    position: relative;
}

.tech-pill-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
}

.tech-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    cursor: pointer;
    white-space: nowrap;
}

.tech-pill:hover {
    border-color: var(--text-gray);
    color: var(--text-primary);
    background: var(--bg-primary);
}

.tech-pill-icon {
    width: 15px;
    height: 15px;
    object-fit: contain;
    flex-shrink: 0;
}

/* Show correct icon variant per theme */
.tech-pill-icon.light-only { display: inline; }
.tech-pill-icon.dark-only  { display: none; }

[data-theme="dark"] .tech-pill-icon.light-only { display: none; }
[data-theme="dark"] .tech-pill-icon.dark-only  { display: inline; }

.hero-socials {
    display: flex;
    gap: 0.9rem;
    margin-top: 0.2rem;
    position: relative;
    z-index: 30;
    flex-wrap: wrap;
}

.hero-link-anchor {
    text-decoration: none;
    position: relative;
    display: inline-flex;
    margin-right: 0.2rem;
}

.hero-link-gradient {
    border-radius: 999px;
}

.hero-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
    border: none;
    border-radius: 999px;
    padding: 0.68rem 1.2rem;
    min-width: 96px;
    min-height: 44px;
    background-color: var(--bg-secondary);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07), 0 8px 20px rgba(0, 0, 0, 0.25);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
}

.hero-link > span {
    position: relative;
    z-index: 2;
}

.hero-link-tooltip {
    position: absolute;
    left: 50%;
    top: 110%;
    transform: translate(-50%, 0);
    background: rgba(15, 15, 15, 0.95);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.75rem 1rem;
    width: 220px;
    opacity: 0;
    pointer-events: none;
    z-index: 220;
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
}

[data-theme="light"] .hero-link-tooltip {
    background: linear-gradient(180deg, #faf5ea 0%, #f6efe0 100%);
    border: 1px solid #e8ddc7;
    box-shadow: 0 6px 16px rgba(95, 75, 35, 0.10);
}

.hero-link-tooltip p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-gray);
}

.hero-link-tooltip span {
    font-size: 0.75rem;
    color: var(--text-secondary);
    display: block;
    margin-top: 0.25rem;
}

[data-theme="light"] .hero-link-tooltip p {
    color: #605438;
}

[data-theme="light"] .hero-link-tooltip span {
    color: #7d6b46;
}

.hero-link-anchor:hover .hero-link {
    transform: translateY(-1px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.09), 0 10px 22px rgba(0, 0, 0, 0.3);
}

.hero-link-anchor:hover .hero-link-tooltip {
    opacity: 1;
    transform: translate(-50%, 4px);
}

.hero-link-anchor:first-child .hero-link-tooltip {
    left: 0;
    transform: translate(0, 0);
}

.hero-link-anchor:first-child:hover .hero-link-tooltip {
    transform: translate(0, 4px);
}

.hero-link-anchor:last-child .hero-link-tooltip {
    left: auto;
    right: 0;
    transform: translate(0, 0);
}

.hero-link-anchor:last-child:hover .hero-link-tooltip {
    transform: translate(0, 4px);
}

[data-theme="light"] .hero-link {
    color: var(--text-primary);
    background-color: var(--bg-secondary);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35), 0 8px 18px rgba(0, 0, 0, 0.08);
}
.tech-stack-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.35rem;
    row-gap: 0.3rem;
    font-size: 0.875rem;
    color: var(--text-gray);
    font-weight: 500;
    margin-top: 0.35rem;
}

.tech-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

.tech-separator {
    color: var(--text-gray);
    font-weight: 600;
}

/* SECTION */
.section-minimal {
    padding: 0 0 3rem;
    position: relative;
    z-index: 1;
}

.section-heading {
    font-size: 1.625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
    position: relative;
    padding: 1.25rem 0;
}

/* line above heading */
.section-heading::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

/* suppress duplicate line when section-heading directly follows section-title */
.section-title + .section-heading::before {
    border-top: none;
}
/* remove bottom margin gap so heading sits flush */
.section-title:has(+ .section-heading) {
    margin-bottom: 0;
}

/* line below heading */
.section-heading::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

/* ABOUT */
.about-section {
    padding: 0 0 3rem;
    position: relative;
}


.about-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: 'Courier New', monospace;
    font-size: 0.9375rem;
    line-height: 1.85;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
}

.about-para {
    margin: 0;
}

.about-highlight {
    color: var(--text-primary);
    font-weight: 600;
}

.about-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding-left: 0.25rem;
}

.about-list-item {
    display: flex;
    gap: 0.625rem;
}

.about-bullet {
    color: var(--text-gray);
    margin-top: 2px;
    flex-shrink: 0;
}

/* FOOTER */
.footer-section {
    padding: 0;
    margin: 1rem 0;
    position: relative;
    z-index: 10;
}


.footer-brand {
    position: relative;
}

.footer-brand::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    background: repeating-linear-gradient(
        to right,
        var(--border-dotted) 0px,
        var(--border-dotted) 6px,
        transparent 6px,
        transparent 14px
    );
    pointer-events: none;
}

.footer-brand-row {
    display: flex;
    align-items: center;
    min-height: 100px;
}

.footer-brand-divider {
    height: 1px;
    background: var(--line-color);
}

.footer-brand-label {
    writing-mode: vertical-lr;
    text-orientation: mixed;
    transform: rotate(180deg);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-gray);
    padding: 1.25rem 1rem;
    border-right: 1px solid var(--line-color);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
}

.footer-brand-mark {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
}

.footer-signature {
    font-family: var(--font-dancing);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
}

.footer-brand-logotype {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem;
}

.footer-logotype-mark {
    font-family: 'Courier New', 'Courier', monospace;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    border: 1.5px solid var(--text-primary);
    padding: 0.2rem 0.35rem;
    line-height: 1;
}

.footer-logotype-name {
    font-family: 'Courier New', 'Courier', monospace;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: 0.02em;
}

.footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 0 5rem;
    position: relative;
}

.footer-bottom::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 100%;
    background-image: radial-gradient(circle, rgba(255,255,255,0.18) 1.2px, transparent 1.2px);
    background-size: 10px 10px;
    pointer-events: none;
    z-index: 0;
}

[data-theme="light"] .footer-bottom::before {
    background-image: radial-gradient(circle, rgba(0,0,0,0.13) 1.2px, transparent 1.2px);
}

.footer-bottom > * {
    position: relative;
    z-index: 1;
}

.footer-copyright {
    font-size: 0.8rem;
    color: var(--text-gray);
}

.footer-icons {
    display: flex;
    align-items: center;
    gap: 0;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
}

.footer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 38px;
    color: var(--text-gray);
    transition: color 0.2s ease, background-color 0.2s ease;
    cursor: default;
}

.footer-icon:hover {
    color: var(--text-primary);
    background-color: var(--bg-secondary);
}

.footer-icon-sep {
    width: 1px;
    height: 38px;
    background: var(--border-color);
    flex-shrink: 0;
}

/* Visitor World Map */
.visitors-map-section {
    position: relative;
    padding: 2rem 0 0;
}
.visitors-map-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}
.visitors-map-wrap {
    width: 100%;
    /* viewBox is 119×60 — lock the aspect ratio so SVG has height */
    aspect-ratio: 119 / 60;
    overflow: hidden;
    opacity: 0.8;
}
.visitors-map-wrap svg {
    width: 100%;
    height: 100%;
    display: block;
}
.visitors-map-count {
    font-size: 0.72rem;
    color: var(--text-gray);
    font-family: 'Courier New', monospace;
    margin: 0.75rem 0 0;
    padding-bottom: 1.5rem;
    text-align: center;
    letter-spacing: 0.03em;
}

.section-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-gray);
    margin-bottom: 2rem;
    position: relative;
    padding: 0.75rem 0;
}

.section-title::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.section-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.section-content {
    position: relative;
    z-index: 1;
}

.section-divider {
    border: none;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    opacity: 0.5;
    margin: 2.5rem calc(-50vw + 50%) 0;
    width: 100vw;
}

.section-description {
    color: var(--text-secondary);
    max-width: 720px;
    margin-bottom: 1.5rem;
    line-height: 1.5;
}

.skill-pill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
}

.skill-pill {
    border: 1px solid var(--line-color);
    border-radius: 999px;
    padding: 0.65rem 1.2rem;
    background: rgba(255, 255, 255, 0.02);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
}

.skill-pill:hover {
    border-color: var(--accent);
    background: rgba(34, 197, 94, 0.12);
}

/* (duplicate removed — see .section-minimal above) */

/* PROJECTS GRID */
.project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
}

.project-card {
    padding: 0;
    border: 1px dashed var(--border-dotted);
    border-radius: 10px;
    overflow: hidden;
    transition: background-color 0.2s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text-primary);
}

.project-card:visited {
    color: var(--text-primary);
}

.project-card:hover {
    background-color: var(--bg-secondary);
}

.project-card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background-color: var(--bg-secondary);
    border-radius: 9px 9px 0 0;
}

.project-image-inner {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.project-card:hover .project-image-inner {
    transform: scale(1.03);
}

.project-screen-label {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    background: rgba(0, 0, 0, 0.62);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    text-transform: uppercase;
    pointer-events: none;
    backdrop-filter: blur(4px);
}

.project-pin-icon {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    backdrop-filter: blur(4px);
}

.project-card-body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.project-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.35rem;
    gap: 0.5rem;
}

.project-name {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
}

.project-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
    flex-shrink: 0;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
}

.status-dot.live { background-color: #22c55e; box-shadow: 0 0 6px #22c55e; }
.status-dot.building { background-color: #ef4444; box-shadow: 0 0 6px #ef4444; }

.project-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 0.85rem;
    line-height: 1.55;
}

.view-project {
    margin-top: auto;
    font-size: 0.8rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-gray);
}

.project-card:hover .view-project {
    color: var(--text-primary);
}

.project-view-all-row {
    display: flex;
    justify-content: flex-end;
    padding: 0.9rem 0 0;
}

.project-view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
}

.project-view-all-btn:hover {
    color: var(--text-primary);
    border-bottom-color: var(--text-primary);
}

/* PROJECT CARD (new CSS-var based classes) */
.project-card-link {
    display: flex;
    flex-direction: column;
    border: 1px dashed var(--border-dotted);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
    background: transparent;
    transition: background-color 0.2s ease;
    cursor: pointer;
}

.project-card-link:hover {
    background-color: var(--bg-secondary);
}

.project-card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background-color: var(--bg-secondary);
}

.project-card-image-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.project-card-link:hover .project-card-image-inner {
    transform: scale(1.03);
}

.project-card-screen-label {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    background: rgba(0, 0, 0, 0.62);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    text-transform: uppercase;
    pointer-events: none;
    backdrop-filter: blur(4px);
}

.project-card-pin-btn {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    backdrop-filter: blur(4px);
}

.project-card-body {
    padding: 1.1rem 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0;
}

.project-card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
    gap: 0.5rem;
}

.project-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
}

.project-card-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
}

.project-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
}

.project-status-dot.dot-live     { background: #22c55e; box-shadow: 0 0 6px #22c55e; }
.project-status-dot.dot-building { background: #ef4444; box-shadow: 0 0 6px #ef4444; }

.project-status-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
}

.project-card-desc {
    font-size: 0.865rem;
    color: var(--text-secondary);
    line-height: 1.58;
    margin-bottom: 0.75rem;
    flex: 1;
}

.project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.85rem;
}

.project-card-tag {
    font-size: 0.7rem;
    font-family: 'Courier New', monospace;
    color: var(--text-gray);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.15em 0.5em;
    white-space: nowrap;
}

.project-card-view-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-gray);
    transition: color 0.15s;
    margin-top: auto;
}

.project-card-link:hover .project-card-view-link {
    color: var(--text-primary);
}

.project-view-all-wrap {
    display: flex;
    justify-content: flex-end;
    padding-top: 1rem;
}

/* PROJECTS PAGE */
.projects-page-header {
    max-width: 760px;
    margin: 0 auto;
    padding: 1rem 1.5rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 1rem;
}

.projects-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
}

.projects-back-link:hover {
    color: var(--text-primary);
}

.projects-page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
}

.projects-page-grid {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

@media (max-width: 600px) {
    .projects-page-grid { grid-template-columns: 1fr; gap: 1rem; }
    .projects-page-header { padding: 1.5rem 1rem 1rem; }
}

/* TECH STACK & SKILLS */
.skills-grid {
    display: flex;
    flex-direction: column;
}

.skill-category {
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-color);
}

.skill-category:last-child {
    border-bottom: none;
}

.skill-label {
    font-weight: 600;
    color: var(--text-primary);
    min-width: 120px;
}

.skill-items {
    color: var(--text-secondary);
    text-align: right;
}

/* UNDERLINES */
.underline-link {
    text-decoration: none;
    border-bottom: 2px solid var(--text-primary);
    color: var(--text-primary);
    font-weight: 600;
}

/* MODAL */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-primary);
    z-index: 5000;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
    width: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    width: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    min-height: 100vh;
}

.modal-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    margin-bottom: 2rem;
    background-color: #000;
}

.modal-action-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px dashed var(--border-dotted);
    margin-bottom: 3rem;
}

.modal-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    width: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    transition: all 0.2s ease;
}

.modal-action-btn:last-child {
    border-right: none;
}

.modal-action-btn:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
}

.project-page {
    min-height: 100vh;
    padding: 1rem 0 2rem;
}

.project-page-shell {
    max-width: 860px;
    margin: 0 auto;
    width: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    width: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    padding: 1rem 2rem 3rem;
}

.project-page-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
}

.project-page-back:hover {
    color: var(--text-primary);
}

.project-page-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    margin-bottom: 1.5rem;
    background-color: #000;
}

.project-page-action-bar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px dashed var(--border-dotted);
    margin-bottom: 2rem;
}

.project-page-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    width: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    transition: all 0.2s ease;
}

.project-page-action-btn:last-child {
    border-right: none;
}

.project-page-action-btn:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
}

.project-page-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    gap: 1rem;
}

.project-page-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
}

.project-page-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.75;
}

.project-page-case-study {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
}

.project-page-stack-section {
    padding-top: 0;
}

.project-page-stack-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    padding: 1rem 0;
    position: relative;
}
.project-page-stack-title::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}
.project-page-stack-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.modal-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
}

.modal-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
}

.modal-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.8;
}

.modal-case-study {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.25rem;
}

.case-study-block {
    border: 1px dashed var(--border-dotted);
    background: rgba(255, 255, 255, 0.02);
    padding: 1rem 1.1rem;
}

.case-study-title {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-gray);
    margin-bottom: 0;
    padding: 0.5rem 0;
    position: relative;
}
.case-study-title::before {
    content: "";
    position: absolute;
    top: 0;
    left: -1.1rem;
    width: calc(100% + 2.2rem);
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}
.case-study-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: -1.1rem;
    width: calc(100% + 2.2rem);
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}
.case-study-title + .case-study-text {
    margin-top: 0.55rem;
}

.case-study-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
}

.modal-stack-section {
    padding-top: 2rem;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
}

.modal-stack-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
}

.stack-pill-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.stack-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 0.825rem;
    font-weight: 500;
    background-color: var(--bg-secondary);
    color: var(--text-primary);
}

/* GITHUB SECTION */
.github-section {
    padding: 0 0 3rem;
    position: relative;
}


.github-section-header {
    margin-bottom: 1.75rem;
}

.github-view-profile {
    display: inline-block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-top: 0.1rem;
    transition: color 0.15s ease;
}

.github-view-profile:hover {
    color: var(--text-secondary);
}

.github-calendar-wrap {
    width: 100%;
    overflow: hidden;
}

.github-calendar-scroll {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
}

.github-calendar-scroll::-webkit-scrollbar {
    display: none;
}

.github-section-tagline {
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-top: 2rem;
    padding-top: 2rem;
    position: relative;
}
.github-section-tagline::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

/* GitHub Graph Refined - Custom Heatmap */
.github-graph-outer {
    position: relative;
    width: 100%;
    margin: 2rem 0;
}

.github-graph-scroll {
    width: 100%;
    overflow-x: auto;
    padding-bottom: 1rem;
    scrollbar-width: none;
    position: relative;
}

.github-graph-scroll::-webkit-scrollbar {
    display: none;
}

.github-heatmap-svg {
    display: block;
}

.gh-day {
    transition: all 0.2s ease;
}

.github-minimal .gh-day.level-0 {
    fill: #f1f3f5;
    stroke: #d1d5db;
    stroke-width: 0.8px;
}

.github-minimal .gh-day.level-1 { fill: #9be9a8; }
.github-minimal .gh-day.level-2 { fill: #40c463; }
.github-minimal .gh-day.level-3 { fill: #30a14e; }
.github-minimal .gh-day.level-4 { fill: #216e39; }

[data-theme="dark"] .github-minimal .gh-day.level-0 {
    fill: #161b22;
    stroke: transparent;
}

[data-theme="dark"] .github-minimal .gh-day.level-1 { fill: #0e4429; }
[data-theme="dark"] .github-minimal .gh-day.level-2 { fill: #006d32; }
[data-theme="dark"] .github-minimal .gh-day.level-3 { fill: #26a641; }
[data-theme="dark"] .github-minimal .gh-day.level-4 { fill: #39d353; }

/* Tooltip */
.gh-tooltip {
    background: #000;
    color: #fff;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    white-space: nowrap;
    border: 1px solid #333;
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    z-index: 10;
    animation: fadeIn 0.1s ease-out;
}

.github-title-wrapper {
    display: flex;
    align-items: center;
    gap: 2rem;
}

/* Year Pill Nav - Between Lines */
.year-pill-nav {
    display: flex;
    gap: 0;
    border: 1px dashed var(--border-dotted);
    border-radius: 4px;
    overflow: hidden;
}

.year-pill {
    padding: 0.25rem 1rem;
    font-size: 0.75rem;
    font-weight: 800;
    background: none;
    border: none;
    color: var(--text-gray);
    cursor: pointer;
    transition: all 0.2s ease;
    width: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to bottom, black 0, black 10px, transparent 10px, transparent 18px);
}

.year-pill:last-child {
    border-right: none;
}

.year-pill.active {
    background-color: var(--text-primary);
    color: var(--bg-primary);
}

.count-accent {
    color: var(--accent);
    font-weight: 800;
}

/* ANIMATIONS */
@keyframes fadeIn {
    from { opacity: 0; filter: blur(4px); }
    to { opacity: 1; filter: blur(0); }
}

@keyframes animate-cell-ripple {
  0% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.05); }
  100% { opacity: 0.4; transform: scale(1); }
}

.animate-cell-ripple {
  animation: animate-cell-ripple var(--duration) var(--delay) ease-out 2;
}

.mask-radial-at-top {
  mask-image: radial-gradient(circle at top, black, transparent);
}

.mask-radial-from-20 {
  mask-image: radial-gradient(circle, black 20%, transparent 80%);
}

/* EXPERIENCE */
.experience-list {
    display: flex;
    flex-direction: column;
}

.experience-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-color);
}

.experience-item:last-child {
    border-bottom: none;
}

.experience-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
}

.experience-role {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1rem;
}

.experience-separator {
    color: var(--text-gray);
}

.experience-company {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 1rem;
}

.experience-meta {
    font-size: 0.8125rem;
    color: var(--text-gray);
    font-weight: 500;
    white-space: nowrap;
}

.experience-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.experience-bullets li {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    padding-left: 1.1rem;
    position: relative;
}

.experience-bullets li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--text-gray);
    font-weight: 700;
}

/* SCROLL REVEAL */
.reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1), transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

/* BLOG PAGE */
.blog-page-header {
    padding: 2.5rem 0 2rem;
    position: relative;
}
.blog-page-header::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.blog-page-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
}

.blog-page-subtitle {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 480px;
}

.blog-post-list {
    display: flex;
    flex-direction: column;
}

.blog-post-item-link {
    display: block;
    text-decoration: none;
    color: inherit;
}

.blog-post-item {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 2rem;
    padding: 2rem 0;
    position: relative;
    cursor: pointer;
    transition: background-color 0.15s ease;
}
.blog-post-item::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.blog-post-item:last-child::after {
    display: none;
}

.blog-post-meta {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.2rem;
}

.blog-post-date {
    font-size: 0.8rem;
    color: var(--text-gray);
    font-family: 'Courier New', monospace;
    white-space: nowrap;
}

.blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
}

.blog-tag {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    color: var(--text-gray);
    white-space: nowrap;
}

.blog-post-content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.blog-post-title {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    line-height: 1.35;
}

.blog-post-excerpt {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
}

.blog-post-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-gray);
    margin-top: 0.25rem;
    transition: color 0.15s ease;
}

.blog-post-item:hover .blog-post-link {
    color: var(--text-primary);
}

.blog-post-item:hover .blog-post-title {
    color: var(--text-primary);
}

/* ================================
   BLOG ARTICLE PAGE
   ================================ */

.blog-article-header {
    padding: 2.5rem 0 2rem;
    position: relative;
}
.blog-article-header::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.blog-article-meta {
    font-size: 0.8rem;
    color: var(--text-gray);
    font-family: 'Courier New', monospace;
    margin-bottom: 0.75rem;
    letter-spacing: 0.02em;
}

.blog-article-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
}

.blog-article-excerpt {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 1rem;
}

.blog-article-body {
    padding: 2.5rem 0 4rem;
    max-width: 700px;
}

.blog-article-body h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 2.75rem 0 1rem;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    padding: 0.65rem 0;
    position: relative;
}
.blog-article-body h2::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}
.blog-article-body h2::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
}

.blog-article-body h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 2rem 0 0.65rem;
    color: var(--text-primary);
    padding: 0.5rem 0;
    position: relative;
}
.blog-article-body h3::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
    opacity: 0.5;
}
.blog-article-body h3::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    pointer-events: none;
    opacity: 0.5;
}

.blog-article-body p {
    font-size: 0.975rem;
    line-height: 1.85;
    color: var(--text-secondary);
    margin-bottom: 1.35rem;
}

.blog-article-body strong {
    color: var(--text-primary);
    font-weight: 600;
}

.blog-article-body a {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
}

.blog-article-body code {
    font-family: 'Courier New', monospace;
    font-size: 0.875em;
    background: var(--bg-secondary);
    padding: 0.15em 0.45em;
    border-radius: 3px;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
}

.blog-article-body pre {
    background: var(--bg-secondary);
    border: 1px dashed var(--border-dotted);
    border-radius: 8px;
    padding: 1.35rem 1.5rem;
    overflow-x: auto;
    margin: 1.75rem 0;
    line-height: 1.65;
}

.blog-article-body pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.blog-article-body ul,
.blog-article-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.35rem;
}

.blog-article-body li {
    font-size: 0.975rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
}

.blog-article-body blockquote {
    border-left: 3px solid var(--border-dotted);
    padding: 0.25rem 1rem;
    color: var(--text-gray);
    margin: 1.75rem 0;
    font-style: italic;
}

.blog-mermaid {
    margin: 2.25rem 0;
    padding: 2rem 1.5rem;
    background: var(--bg-secondary);
    border: 1px dashed var(--border-dotted);
    border-radius: 8px;
    overflow-x: auto;
    display: flex;
    justify-content: center;
    align-items: center;
}

.blog-mermaid svg {
    max-width: 100%;
    height: auto;
}

/* RESPONSIVE */
@media (max-width: 1100px) {
    .main-wrapper { max-width: 81%; }
}

@media (max-width: 768px) {
    .main-wrapper {
        max-width: 100%;
        padding: 0.75rem 1rem 2rem;
    }
    .main-wrapper::before,
    .main-wrapper::after {
        display: none;
    }
    .container { padding: 0 1rem; }

    /* Nav — match main-wrapper side padding so negative margin still works */
    .site-nav { margin: 0 -1rem; padding: 0 1rem; }
    .site-nav-search-kbd { display: none; }
    .site-nav-search { padding: 0.3rem 0.45rem; }

    /* Hero banner */
    .hero-banner { padding: 2.5rem 1rem; min-height: 160px; }

    /* Hero profile */
    .hero-profile-row { flex-direction: column; }
    .hero-avatar-col { width: 100%; border-right: none; height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px); padding: 0 1.5rem 1rem; }
    .hero-name-block { padding: 0.65rem 1rem 0.85rem; min-height: unset; }
    .hero-code-hint { display: none; }
    .hero-name { font-size: 1.35rem; }

    /* Hero social cards */
    .hero-social-grid { grid-template-columns: 1fr; }
    .hero-social-card { padding: 0.75rem 0.85rem; gap: 0.65rem; }
    .hero-info-grid { grid-template-columns: 1fr; }

    /* Section headings */
    .section-heading { font-size: 1.2rem; margin-bottom: 1rem; }

    /* Footer */
    .footer-brand-row { min-height: 70px; }
    .footer-brand-mark { padding: 1rem; }
    .footer-brand-logotype { padding: 1rem; gap: 0.5rem; }
    .footer-logotype-name { font-size: 1rem; }
    .footer-logotype-mark { font-size: 1.1rem; }

    /* Grids */
    .project-grid { grid-template-columns: 1fr; gap: 0.85rem; }
    .blog-post-item { grid-template-columns: 1fr; gap: 0.5rem; }
    .blog-post-meta { flex-direction: row; align-items: center; flex-wrap: wrap; gap: 0.5rem; }

    /* Modals */
    .modal-action-bar { grid-template-columns: 1fr; }
    .modal-action-btn { border-right: none; height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px); }
    .modal-action-btn:last-child { border-bottom: none; }
    .modal-title { font-size: 2rem; }
    .modal-case-study { grid-template-columns: 1fr; }

    /* Project page */
    .project-page-shell {
        border-left: none;
        border-right: none;
        padding: 0.5rem 0.75rem 2rem;
    }
    .project-page-action-bar { grid-template-columns: 1fr; }
    .project-page-action-btn { border-right: none; height: 1px;
    border: none;
    background-color: var(--border-dotted);
    mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px);
    -webkit-mask-image: repeating-linear-gradient(to right, black 0, black 10px, transparent 10px, transparent 18px); }
    .project-page-action-btn:last-child { border-bottom: none; }
    .project-page-title-row { align-items: flex-start; flex-direction: column; }
    .project-page-case-study { grid-template-columns: 1fr; }

    /* Experience */
    .experience-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
    }
    .experience-meta {
        white-space: normal;
    }
}

@media (max-width: 480px) {
    .site-nav-search { display: none; }
    .hero-banner { padding: 1.75rem 1rem; min-height: 120px; }
    .footer-brand-label { display: none; }
}
